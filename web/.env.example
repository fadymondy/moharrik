# The Moharrik Go API origin. next.config.mjs proxies /api and /graphql to it, and proxy.ts
# asks it who the viewer is. Defaults to http://localhost:8120.
API_ORIGIN=http://localhost:8120

# Shown in the ready-to-paste `claude mcp add` line on the MCP tokens screen.
# Defaults to http://localhost:8120 (the MCP endpoint is <origin>/api/mcp).
NEXT_PUBLIC_MCP_ORIGIN=http://localhost:8120
