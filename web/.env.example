# The Moharrik Go API origin. next.config.mjs proxies /api and /graphql to it, and proxy.ts
# asks it who the viewer is. Defaults to http://localhost:8120.
API_ORIGIN=http://localhost:8120

# Fallback ONLY, used as <origin>/api/mcp while the MCP tokens screen's first
# fetch of /api/w/oauth_grants hasn't answered yet. Once it has, the URL shown
# and pasted into every client's config comes from the API's own MCPServerURL
# (internal/mcp/oauth.go): MCP_PUBLIC_URL's dedicated host if the API has one
# configured, else the legacy <APP_URL>/api/mcp (MH-516). Defaults to
# http://localhost:8120.
NEXT_PUBLIC_MCP_ORIGIN=http://localhost:8120
