{
  "_comment": "ONE table of cases for the allow-list rule, run by BOTH implementations: guardrails_test.go (HostAllowed, normaliseHost) and extension/test/hosts.test.mjs (hostAllowed, normaliseHost in extension/hosts.js). A case added here is checked on both sides; a change to one side that the other does not share fails a test (MH-422).",
  "normalise": [
    ["https://example.com/path?q=1", "example.com"],
    ["HTTP://Example.COM", "example.com"],
    ["example.com:8443", "example.com"],
    ["https://example.com:8443/x", "example.com"],
    ["example.com/", "example.com"],
    ["  example.com  ", "example.com"],
    ["example.com.", "example.com"],
    ["www.example.com", "www.example.com"],
    ["not a host", ""],
    ["https://", ""],
    ["", ""],
    ["   ", ""]
  ],
  "allowed": [
    { "list": ["example.com"], "host": "example.com", "allowed": true },
    { "list": ["example.com"], "host": "www.example.com", "allowed": true },
    { "list": ["example.com"], "host": "app.example.com", "allowed": true },
    { "list": ["example.com"], "host": "a.b.example.com", "allowed": true },
    { "list": ["example.com"], "host": "EXAMPLE.com", "allowed": true },
    { "list": ["example.com"], "host": "example.com.", "allowed": true },
    { "list": ["example.com"], "host": "example.com:8443", "allowed": true },
    { "list": ["Example.COM "], "host": "example.com", "allowed": true },
    { "list": ["https://example.com/login"], "host": "example.com", "allowed": true },
    { "list": ["example.com:8080"], "host": "example.com", "allowed": true },
    { "list": ["example.com"], "host": "notexample.com", "allowed": false },
    { "list": ["example.com"], "host": "example.com.evil.io", "allowed": false },
    { "list": ["example.com"], "host": "evil-example.com", "allowed": false },
    { "list": ["example.com"], "host": "example.org", "allowed": false },
    { "list": ["mail.google.com"], "host": "google.com", "allowed": false },
    { "list": ["mail.google.com"], "host": "mail.google.com", "allowed": true },
    { "list": ["www.example.com"], "host": "example.com", "allowed": false },
    { "list": ["www.example.com"], "host": "www.example.com", "allowed": true },
    { "list": ["allowed.localhost"], "host": "sub.allowed.localhost", "allowed": true },
    { "list": ["allowed.localhost"], "host": "evil.localhost", "allowed": false },
    { "list": ["127.0.0.1"], "host": "127.0.0.1", "allowed": true },
    { "list": ["127.0.0.1"], "host": "localhost", "allowed": false },
    { "list": ["example.com"], "host": "", "allowed": false },
    { "list": ["example.com"], "host": "   ", "allowed": false },
    { "list": [], "host": "example.com", "allowed": false },
    { "list": ["", "  "], "host": "example.com", "allowed": false }
  ]
}
