# Moharrik — local development. Copy to .env and fill the two secrets.
# Ports: API :8120, web :3120, Postgres (docker compose) :55470. See README.

# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8120
ADDR=:8120

# ─── Database ────────────────────────────────────────────────────────────
# Two roles on purpose (README, "Tenancy"):
#   DATABASE_URL      the OWNER role — migrations, auth, tenant resolution, admin MCP
#   APP_DATABASE_URL  the APP role — no superuser, no BYPASSRLS, owns nothing; every
#                     generated route runs on it with row-level security enforced.
# `togo migrate` creates/updates the app role from APP_DATABASE_URL.
DB_DRIVER=pgx
DATABASE_URL=postgres://postgres:postgres@localhost:55470/moharrik?sslmode=disable
APP_DATABASE_URL=postgres://moharrik_app:CHANGE_ME@localhost:55470/moharrik?sslmode=disable

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text

# ─── i18n / storage ──────────────────────────────────────────────────────
LOCALE=en
LOCALE_DIR=lang
STORAGE_DIR=storage
CACHE_DRIVER=memory

# ─── Auth (togo-framework/auth) ──────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_TO_48_RANDOM_CHARS
AUTH_DRIVER=base
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=
CORS_ORIGINS=http://localhost:3120

# OAuth (togo-framework/auth-oauth). Unset = the sign-in buttons are not shown.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ─── Mail ────────────────────────────────────────────────────────────────
# Not used in P0: invitations return a one-time link instead of sending email.
MAIL_DRIVER=log

# ─── Mahaam feedback ─────────────────────────────────────────────────────
# Moharrik files its own problem reports (the in-app "Report a problem" widget and backend
# panics / 5xx) as issues in its Mahaam project. Empty key = reporting off. Never commit a key.
MAHAAM_URL=https://console.mahaam.app
MAHAAM_FEEDBACK_KEY=
MAHAAM_APP_URL=https://moharrik.com
NEXT_PUBLIC_MAHAAM_EMBED_ORIGIN=https://console.mahaam.app
