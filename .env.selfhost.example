# Copy to .env.selfhost (gitignored) and fill in. Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
MOHARRIK_APP_DB_PASSWORD=
AUTH_SECRET=

# The public origin people open (set it when you put a TLS reverse proxy in front).
APP_URL=http://localhost:3000
# Set to 1 behind HTTPS.
COOKIE_SECURE=
# Host port for the app.
MOHARRIK_PORT=3000
