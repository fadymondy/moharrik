{
  "manifest_version": 3,
  "name": "Moharrik",
  "short_name": "Moharrik",
  "version": "0.6.0",
  "description": "Lets a Moharrik workspace drive this browser through the steps you approved, on the sites you allowed.",
  "homepage_url": "https://app.moharrik.com",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moharrik",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "webNavigation",
    "offscreen",
    "debugger",
    "tabGroups"
  ],
  "host_permissions": [
    "https://app.moharrik.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
